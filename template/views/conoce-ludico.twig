{% extends 'base.twig' %}
{% block body %}
	<div class="rts-banner-area-9 rts-section-gap">
		<div class="container">
			<div class="row">
				<div class="col-xl-6">
					<div class="insurance-banner-inner">
						<span class="pre rts-text-anime-style-1">SOLUCIONES QUE TRANSFORMAN ESPACIOS</span>
						<h1 class="title rts-text-anime-style-1">Diseñamos el potencial de cada espacio</h1>
						<p class="disc">
						Suministro e instalación de equipamiento recreativo, deportivo y urbano para proyectos que buscan calidad, funcionalidad y valor a largo plazo.
						</p>
						<a href="{{whatsapp_url}}" class="rts-btn btn-primary">Hablanos de tu proyecto</a>
					</div>
				</div>
			</div>
		</div>
		<div class="image-right-absolute">
			<img class="" src="assets/images/banner/12.webp?x={{ timestamp }}" alt="banner">
		</div>
	</div>

	<div class="rts-pricing-area-one rts-section-gap">
		<div class="container">

			<div class="row mt--100">
				<div class="col-12">
					<div class="tab-content" id="myTabContent">
						<div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
							<div class="row g-5">
								<div class="col-lg-6 col-md-6 col-sm-12 col-12">
									<div class="pricing-wrapper-one">
										<div class="plane-process">

											<h3 class="title">Misión</h3>
										</div>

										<div class="pricing-header-start"></div>

										<div class="pricing-body">
											<div class="single-pricing available">
												<span class="price-details text-justify">Proveer soluciones integrales de mobiliario y equipamiento para áreas deportivas, recreativas y
																									urbanas, ofreciendo productos de calidad, funcionales, seguros y duraderos que contribuyan al desarrollo de
																									espacios públicos y privados más accesibles, atractivos y adecuados para la convivencia, el deporte y la
																									recreación. Brindamos atención personalizada y asesoría especializada a nuestros clientes en el sureste
																									mexicano, trabajando con compromiso, responsabilidad y eficiencia para satisfacer las necesidades de cada
																									proyecto y generar relaciones comerciales sólidas y de largo plazo</span>
											</div>
										</div>
									</div>
								</div>

								<div class="col-lg-6 col-md-6 col-sm-12 col-12 mt_sm--80">
									<div class="pricing-wrapper-one">
										<div class="plane-process">
											<h3 class="title">Visión</h3>
										</div>
										<div class="pricing-header-start"></div>
										<div class="pricing-body">
											<div class="single-pricing available">
												<span class="price-details text-justify">Ser una empresa líder y referente en el sureste de México en la comercialización de mobiliario y
																										equipamiento para espacios deportivos, recreativos y urbanos, reconocida por la calidad de sus productos, la
																										confiabilidad de su servicio y su capacidad para ofrecer soluciones innovadoras e integrales. Buscamos
																										consolidar nuestra presencia en la región y ampliar continuamente nuestro alcance, participando en proyectos
																										que contribuyan a crear espacios modernos, seguros, funcionales y sustentables que mejoren la calidad de vida
																										y fomenten la convivencia de las comunidades.</span>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>

	    <div class="rts-cta-area-one rts-section-gapBottom">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="cta-main-area-wrapper-one bg_image">
                        <div class="left-areas">
                            <span class="pre">SOLUCIONES INTEGRALES PARA CADA PROYECTO</span>
                            <h3 class="title">Equipamos espacios que generan valor</h3>
                        </div>
                        <div class="right-area">
                            <div class="inpur-area-main">                                
                                <a href="{{whatsapp_url}}" class="rts-btn btn-primary">Conoce nuestra propuesta</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
