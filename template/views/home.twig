{% extends 'base.twig' %}
{% block body %}
	<div class="banner-swiper-two rts-banner-hr">
		<div class="swiper mySwiper-banner-two">
			<div class="swiper-wrapper">
				<div class="swiper-slide">
					<div class="rts-banner-area-two rts-section-gap bg_image">
						<div class="container">
							<div class="row">
								<div class="col-lg-12">
									<div class="banner-inner-two-content">

										<h1 class="title">Espacios que inspiran a jugar</h1>
										<p class="disc">
											Equipamiento infantil para parques, escuelas, desarrollos habitacionales, hoteles y espacios recreativos.
										</p>
										<a href="juegos-infantiles" class="rts-btn btn-primary btn-white">Conoce nuestros juegos</a>
									</div>
								</div>
							</div>
						</div>
						<div class="shape-area-start">

							<div class="shape shape-four">
								<img loading="lazy" src="assets/images/banner/shape/04.webp" alt="shape-area">
							</div>
						</div>
					</div>

				</div>
				<div class="swiper-slide">
					<div class="rts-banner-area-two two rts-section-gap bg_image">
						<div class="container">
							<div class="row">
								<div class="col-lg-12">
									<div class="banner-inner-two-content">

										<h1 class="title">Diseña espacios seguros y funcionales</h1>
										<p class="disc">
											Superficies especializadas para áreas infantiles, deportivas y recreativas, diseñadas para complementar tus proyectos.
										</p>
										<a href="contacto" class="rts-btn btn-primary btn-white">Solicita un asesoramiento</a>
									</div>
								</div>
							</div>
						</div>
						<div class="shape-area-start">
							<div class="shape shape-four">
								<img loading="lazy" src="assets/images/banner/shape/04.webp" alt="">
							</div>
						</div>
					</div>
				</div>
				<div class="swiper-slide">
					<div class="rts-banner-area-two three rts-section-gap bg_image">
						<div class="container">
							<div class="row">
								<div class="col-lg-12">
									<div class="banner-inner-two-content">

										<h1 class="title">Convierte cualquier espacio en un área deportiva</h1>
										<p class="disc">
											Equipamiento deportivo para parques, unidades deportivas, desarrollos urbanos, hoteles y proyectos institucionales.
										</p>
										<a href="equipos-gimnasios" class="rts-btn btn-primary btn-white">Ver equipamiento</a>
									</div>
								</div>
							</div>
						</div>
						<div class="shape-area-start">

							<div class="shape shape-four">
								<img loading="lazy" src="assets/images/banner/shape/04.webp" alt="">
							</div>
						</div>
					</div>
				</div>

			</div>
			<div class="swiper-button-next">
				<i class="fa-light fa-chevron-right"></i>
			</div>
			<div class="swiper-button-prev">
				<i class="fa-light fa-chevron-left"></i>
			</div>

		</div>

	</div>
	<div class="rts-service-area rts-section-gap">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="title-area-between-hr">
                            <div class="title-area-hr-left">
                              
                                <h2 class="title rts-text-anime-style-1">
                                   Nuestra línea
                                </h2>
								<span class="pre">
                                   Contamos con una amplia gama de productos para equipamiento infantil, superficies y mobiliario urbano, diseñados para crear espacios seguros y funcionales.
                                </span>
                            </div>
                          
                        </div>
                    </div>
                </div>

                <div class="row g-5 mt--40">
				{% for categoria in categorias %}
                    <div class="col-xl-4 col-lg-6 col-sm-12" data-animation="fadeInUp" data-delay="0.1"
                        data-duration="1.2">
                        <div class="single-service-hr bg_color-dark-1 ">
                            <a href="#" class="thumbnail">
                                <img src="uploads/categorias/{{ categoria.imagen|default('assets/images/default-service.webp') }}" alt="{{ categoria.nombre }}">
                            </a>
                            <div class="inner">

                                <a href="{{categoria.slug}}">
                                    <h3 class="title">{{ categoria.nombre }}</h3>
                                </a>
                                <p class="disc">
                                    {{ categoria.descripcion }}	
                                </p>
                                <a href="{{categoria.slug}}" class="rts-btn btn-secondary">Ver más</a>
                            </div>
                        </div>
                    </div>
                 {% endfor %}
                </div>
            </div>
        </div>

	<div class="rts-about-area-two rts-section-gap">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6">
					<div class="left-thumbnail-about-area-two">
						<img src="assets/images/inicio-1.webp" alt="instalacion de juegos en parques">

					</div>
				</div>
				<div class="col-lg-6 mt_sm--80 mt_md--80">
					<div class="about-inner-content-two">
						<div class="title-style-two left">
							<span class="pre">LUDICO</span>
							<h2 class="title">Más que equipamiento,<br><span class="display-6">
									creamos espacios que generan experiencias.</span>
							</h2>
						</div>
						<div class="about-between-wrapper">
							<p class="disc text-justify">
								No se trata únicamente de instalar un juego, colocar una banca o incorporar un equipo deportivo. Se trata de crear espacios que funcionen, que conecten con las personas y que aporten valor a cada proyecto.
							</p>
							<p class="disc text-justify">Somos especialistas en la comercialización de equipamiento deportivo, recreativo y urbano, desarrollando soluciones para parques, desarrollos habitacionales, escuelas, hoteles, centros deportivos, espacios públicos y proyectos privados.</p>

						</div>
						<div class="call-and-sign-area two mt-5">
							<div class="call-area">
								<div class="icon">
									<i class="fa-sharp fa-regular fa-phone-volume"></i>
								</div>
								<div class="information">
									<span>Contactános
									</span>
									<a href="tel:{{ config.telefono|default('') }}">
										<h6 class="title">{{ config.telefono|default('') }}</h6>
									</a>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
<div class="working-process-area-three rts-section-gap working-process-bg">
        <div class="container">
            <div class="row mt--40">
                <div class="title-style-three center">
                    <span class="pre">De tu idea a un espacio listo para disfrutarse.</span>
                   
                    <h2 class="title rts-text-anime-style-1">¿Cómo trabajamos?</h2>
                </div>
            </div>
            <div class="row g-5 mt--20 align-items-center rts_jump_animation-wrapper">
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 rts-jump__item">
                    <!-- single wirking process -->
                    <div class="rts-working-process-1 text-center">
                        <div class="inner">
                            <div class="icon">
                                <h1><i class="fa-sharp-duotone fa-solid fa-phone "></i></h1>
                            </div>
                        </div>
                        <div class="content">
                            <h6 class="title">Contáctanos</h6>
                            <p class="disc">
                              Compártenos qué necesitas, dónde se instalará y qué tipo de espacio quieres desarrollar.
                            </p>
                        </div>
                    </div>
                    <!-- single wirking process End -->
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 rts-jump__item">
                    <!-- single wirking process -->
                    <div class="rts-working-process-1 process-lg text-center">
                        <div class="inner two">
                            <div class="icon">
                              <h1><i class="fa-solid fa-print-magnifying-glass"></i></h1>
                            </div>
                        </div>
                        <div class="content">
                            <h6 class="title">Analizamos</h6>
                            <p class="disc">
                              Nuestro equipo revisa las características del proyecto
                            </p>
                        </div>
                    </div>
                    <!-- single wirking process End -->
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 rts-jump__item">
                    <!-- single wirking process -->
                    <div class="rts-working-process-1 text-center">
                        <div class="inner three">
                            <div class="icon">
                               <h1><i class="fa-solid fa-file-invoice-dollar"></i></h1>
                            </div>
                        </div>
                        <div class="content">
                            <h6 class="title">Recibe tu propuesta</h6>
                            <p class="disc">
                                Preparamos una propuesta comercial con los productos
                            </p>
                        </div>
                    </div>
                    <!-- single wirking process End -->
                </div>
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 rts-jump__item">
                    <!-- single wirking process -->
                    <div class="rts-working-process-1 process-lg text-center">
                        <div class="inner four">
                            <div class="icon">
                               <h1><i class="fa-solid fa-handshake-angle"></i></h1>
                            </div>
                        </div>
                        <div class="content">
                            <h6 class="title">Confirmamos tu proyecto</h6>
                            <p class="disc">
                               Una vez aprobada la propuesta, coordinamos contigo los siguientes pasos para llevar el proyecto a ejecución.
                            </p>
                        </div>
                    </div>
                  
                </div>
            </div>
        </div>
    </div>


	<div class="rts-call-to-action-area-three bg_image">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="cta-main-wrapper-inner">
						<h2 class="title ">
							Tu proyecto tiene un propósito.
						<span class="subtitle">
							 Nosotros ayudamos a convertirlo en un espacio que se vive.</span></h2>
						<div class="call-area">
							<div class="icon">
								<i class="fa-solid fa-phone-flip"></i>
							</div>
							<a href="tel:{{ config.telefono|default('') }}">{{ config.telefono|default('') }}</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


{% endblock %}
