{% extends 'base.twig' %}

{% block body %}
	{% set imagen_principal = producto.imagen ? 'uploads/productos/' ~ producto.imagen : 'assets/images/default-product.webp' %}
	{% set imagenesGaleria = galeria is not empty ? galeria : [{'Img_Galeria': imagen_principal}] %}

	{% set urlsArray = [] %}
	{% for img in imagenesGaleria %}
		{% set rutaImg = img.Img_Galeria is defined ? img.Img_Galeria : img %}
		{% set urlsArray = urlsArray|merge([baseUrl ~ 'uploads/productos/' ~ rutaImg]) %}
	{% endfor %}
	<div class="rts-sop-details-area ">
		<div class="container">
			<nav aria-label="Migas de pan" class="mb--30">
				<a href="{{ baseUrl }}">Inicio</a>
				{% if categoria %}
					<span class="mx-2">/</span>
					<a href="{{ baseUrl }}{{ categoria.slug }}">{{ categoria.nombre }}</a>
				{% endif %}
				{% if subcategoria %}
					<span class="mx-2">/</span>
					<a href="{{ baseUrl }}{{ subcategoria.slug_subcategoria }}">{{ subcategoria.Subcategoria }}</a>
				{% endif %}
				<span class="mx-2">/</span>
				<span aria-current="page">{{ producto.nombre }}</span>
			</nav>
			<div class="row">
				<div class="col-lg-6">
					<div class="banner-horizental" id="galeria-container" data-imagenes='{{ urlsArray|json_encode|raw }}'>
						<div class="swiper swiper-container-h1">
							<div class="swiper-wrapper">

								{% for img in imagenesGaleria %}
									<div class="swiper-slide">
										<div class="slider-inner">
											{% set rutaImg = img.Img_Galeria is defined ? img.Img_Galeria : img %}
											<img src="https://ludicodemexico.com.mx/uploads/productos/{{ rutaImg }}" alt="{{ producto.nombre }}">
										</div>
									</div>
								{% endfor %}
							</div>
						</div>
						<div class="slider-pagination-area-shop-details">
							<div class="swiper-pagination swiper-pagination-horizontal"></div>
						</div>


					</div>
				</div>
				<div class="col-lg-6 mt_md--180 mt_sm--180 ">
					<div class="ms-single-product__content">
						<h1 class="ms-single-product_title mb-0">{{ producto.nombre }}</h1>
						<p class="sku_wrapper mb-0">
							{{producto.sku ? 'SKU: ' ~ producto.sku : ''}}
						</p>
						<div class="woocommerce-product-details__short-description mt-5">
							<p class="stock in-stock mt-5">DESCRIPCIÓN</p>
							<p class="mb-5">{{ (producto.descripcion) | nl2br }}</p>
						</div>

						<div class="quantity-area">
							<div class="cart-edit">
								<div class="quantity-edit">
									<button type="button" class="button btn-minus" aria-label="Reducir cantidad">
										<i class="fal fa-minus" aria-hidden="true"></i>
									</button>
									<input type="text" class="input item-quantity" value="1" aria-label="Cantidad de {{ producto.nombre }}">
									<button type="button" class="button plus btn-plus" aria-label="Aumentar cantidad">
										<i class="fal fa-plus" aria-hidden="true"></i>
									</button>
								</div>
							</div>
						</div>
						<div class="product_meta">
							<div class="row">
								<div class="col-md-4">
									<a href="#" id="addcart" class="rts-btn btn-three" data-product-id="{{ producto.id }}" data-product-name="{{ producto.nombre }}" data-product-image="{{ baseUrl }}{{ imagen_principal }}">Agregar a cotización</a>
								</div>
								<div class="col-md-4">
									<a href="https://wa.me/{{ config.no_whatsapp }}?text=Hola,%20me%20interesa%20este%20producto:%0A*{{ producto.nombre | url_encode }}*%0ASKU:%20{{ producto.sku }}" target="_blank" data-bs-toggle="tooltip" data-bs-placement="top" title="Contactar por WhatsApp" class="rts-btn btn-primary btn-whats-product">
										<i class="fa-brands fa-whatsapp"></i>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</div>

{% if productosRelacionados is not empty %}
	<div class="rts-related-shop-area" dir="ltr" id="productosrelacionados">
		<div class="container">
			<div class="row">
				<div class="col-lg-12">
					<div class="title-style-five center mb--40">

						<h2 class="title">Productos relacionados</h2>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="col-lg-12">
					<div class="swiper-related-shop-area">
						<div class="swiper mySwiper-related-shop">
							<div class="swiper-wrapper">
								{% for relacionado in productosRelacionados %}
									{% set imagenRelacionado = relacionado.imagen ? 'uploads/productos/' ~ relacionado.imagen : 'assets/images/default-product.webp' %}
									<div class="swiper-slide">
										<div class="rts-single-shop-area">
											<a href="{{ baseUrl }}productos/{{ relacionado.slug }}" class="thumbnail">
												<img src="{{ baseUrl }}{{ imagenRelacionado }}" alt="{{ relacionado.nombre }}" loading="lazy">
											</a>
											<div class="inner-content">
												<a href="{{ baseUrl }}productos/{{ relacionado.slug }}">
													<h4 class="title">{{ relacionado.nombre }}</h4>
													{% if relacionado.sku %}
														<span>SKU:
															{{ relacionado.sku }}</span>
													{% endif %}
												</a>
												<div class="pricing-area-wrapper">
													<a href="{{ baseUrl }}productos/{{ relacionado.slug }}" class="rts-btn btn-primary" aria-label="Ver {{ relacionado.nombre }}" title="Ver producto">
														<i class="fa-solid fa-eye" aria-hidden="true"></i>
													</a>
													<a href="https://wa.me/{{ config.no_whatsapp }}?text={{ ('Hola, me interesa este producto: ' ~ relacionado.nombre ~ ' SKU: ' ~ relacionado.sku)|url_encode }}" target="_blank" rel="noopener noreferrer" class="rts-btn btn-primary" aria-label="Consultar {{ relacionado.nombre }} por WhatsApp" title="Contactar por WhatsApp">
														<i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
													</a>
													<a href="#" class="rts-btn btn-primary" data-bs-toggle="tooltip" data-bs-placement="top" title="Agregar a cotización" aria-label="Agregar {{ relacionado.nombre }} a cotización" id="addcart" data-sku="{{ relacionado.sku }}" data-product-id="{{ relacionado.id }}" data-product-name="{{ relacionado.nombre }}" data-product-image="{{ baseUrl }}{{ imagenRelacionado }}">
														<i class="fa-regular fa-cart-shopping me-1" aria-hidden="true"></i>
													</a>
												</div>
											</div>
										</div>
									</div>
								{% endfor %}

							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endif %}
<div class="rts-cta-area-one rts-section-gapBottom">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="cta-main-area-wrapper-one bg_image">
					<div class="left-areas">

						<h3 class="title">¿Buscas algo diferente?</h3>
						<span class="pre text-none">Solicita una propuesta personalizada.</span>
					</div>
					<div class="right-area">
						<div class="inpur-area-main">
							<a href="{{config.whatsapp}}" target="_blank" class="rts-btn btn-primary">Contacta ahora</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>{% endblock %}{% block extraScripts %}
 <script type="text/javascript">
    window.galeriaUrls = [
        {% for imgs in imagenesGaleria %}
            {% set rutaImg = imgs.Img_Galeria is defined ? imgs.Img_Galeria : imgs %}
            "https://ludicodemexico.com.mx/uploads/productos/{{ rutaImg }}",
        {% endfor %}
    ];
</script>{% endblock %}
