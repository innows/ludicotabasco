{% extends "admin/base.twig" %}

{% block extraStyles %}
	<link rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css">
	<style>
		.galeria-container {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 15px;
			margin-top: 20px;
		}
		.galeria-item {
			position: relative;
			border-radius: 8px;
			overflow: hidden;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
			text-align: center;
		}
		.galeria-item img {
			width: 100%;
			height: 150px;
			object-fit: cover;
		}
	</style>
{% endblock %}

{% block body %}

	<div class="form-head d-flex mb-3 mb-md-5 align-items-start flex-wrap justify-content-between">
		<div class="me-auto d-lg-block">
			<h3 class="text-primary font-w600">Perfil del Producto</h3>
		</div>
		<a href="{{ adminUrl }}/administrarproductos" class="btn btn-secondary">
			<i class="fas fa-arrow-left"></i>
			Volver
		</a>
		<input type="hidden" id="productoId" value="{{ producto.id }}">
	</div>

	<div class="row">
		<div class="col-lg-8">
			<div class="card mb-4">
				<div class="card-header">
					<h5 class="mb-0">Información General</h5>
					<button type="button" class="btn btn-primary" id="btnEditarProducto" data-id="{{ producto.id }}" data-bs-toggle="modal" data-bs-target="#modEditarProducto">
						<i class="fas fa-edit"></i>
						Editar
					</button>
				</div>
				<div class="card-body">
					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">
								<strong>Nombre:</strong>
							</label>
							<p>{{ producto.nombre }}</p>
						</div>
						<div class="col-md-6">
							<label class="form-label">
								<strong>SKU:</strong>
							</label>
							<p>{{ producto.sku }}</p>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-md-3">
							<label class="form-label">
								<strong>Precio:</strong>
							</label>
							<p>${{ producto.precio|number_format(2, '.', ',') }}</p>
						</div>
						<div class="col-md-3">
							<label class="form-label">
								<strong>Precio Anterior:</strong>
							</label>
							<p>${{ producto.precio_anterior|default('N/A')|number_format(2, '.', ',') }}</p>
						</div>
						<div class="col-md-6">
							<label class="form-label">
								<strong>Stock:</strong>
							</label>
							<p>{{ producto.stock }}
								unidades</p>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-md-3">
							<label class="form-label">
								<strong>Categoría:</strong>
							</label>
							<p>{{ categoria.nombre|default('No especificada') }}</p>
						</div>
						<div class="col-md-3">
							<label class="form-label">
								<strong>Subcategoría:</strong>
							</label>
							<p>{{ idsubcategoria.Subcategoria|default('No especificada') }}</p>
						</div>
						<div class="col-md-6">
							<label class="form-label">
								<strong>Estado:</strong>
							</label>
							<p>
								{% if producto.estado == '1' %}
									<span class="badge bg-success">Activo</span>
								{% else %}
									<span class="badge bg-danger">Inactivo</span>
								{% endif %}
							</p>
						</div>
					</div>

					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">
								<strong>Descripción:</strong>
							</label>
							<p class="text-justify">{{ producto.descripcion|default('No especificada') }}</p>
						</div>

						<div class="col-md-6">
							<label class="form-label">
								<strong>Información adicional:</strong>
							</label>
							<img src="/../uploads/productos/{{ producto.informacion_adicional|default('default.png') }}" alt="Información adicional" class="img-fluid" width="300" height="350">
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<label class="form-label">
								<strong>Fecha de Creación:</strong>
							</label>
							<p>{{ producto.fecha_creacion }}</p>
						</div>
						<div class="col-md-6">
							<label class="form-label">
								<strong>Última Actualización:</strong>
							</label>
							<p>{{ producto.fecha_actualizacion }}</p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="col-lg-4">

			<div class="card mb-4">
				<div class="card-header">
					<h5 class="mb-0">Imagen Principal</h5>
				</div>
				<div class="card-body">
					{% if producto.imagen %}
						<img src="/../uploads/productos/{{ producto.imagen }}" alt="{{ producto.nombre }}" class="img-fluid rounded">
					{% else %}
						<div class="alert alert-info">No hay imagen principal</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card mb-4">
				<div class="card-header">
					<h5 class="mb-0">
						<i class="fas fa-images"></i>
						Galería de Imágenes ({{ galeria|length }})
					</h5>
					<button type="button" class="btn btn-primary" id="btnAbrirModalImagen" data-bs-toggle="modal" data-bs-target="#modGaleria">
						<i class="fa fa-plus"></i>
						Agregar Imagen
					</button>

				</div>
				<div class="card-body">
					{% if galeria %}
						<div class="galeria-container">
							{% for imagen in galeria %}
								<div class="galeria-item">
									<img src="{{ baseUrl }}uploads/productos/{{ imagen.Img_Galeria }}" alt="Galería" class="img-fluid">
									<p class="btn  mt-3 btn-danger btnEliminarImagen" data-id="{{ imagen.Galeria_ID }}" title="Eliminar imagen" data-bs-target="tooltip">
										<i class="fas fa-trash-alt"></i>
									</p>
								</div>

							{% endfor %}
						</div>
					{% else %}
						<div class="alert alert-info">
							<i class="fas fa-info-circle"></i>
							No hay imágenes en la galería, agregue imagenes para mostrar aquí.
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>


	<div class="modal fade" id="modGaleria" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Galería de Imágenes</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="row">
						<div class="col-12 mb-3">
							<code>
								Las imagenes deben de medir 440px x 440px y no deben exceder de 1GB cada una. Solo se permiten imágenes en formato JPG, PNG
							</code>
						</div>

						<div class="col-md-12">
							<div id="dropzoneArea" class="dropzone border rounded p-4 text-center">
								<div class="dz-message mb-0">
									Arrastra o haz clic aquí para subir la imagen
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-primary" id="btnGuardarGaleria">Guardar</button>
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="modEditarProducto" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Editar Producto</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="row">
						<div class="col-12">
							<form id="formEditarProducto" enctype="multipart/form-data">
								<input type="hidden" name="producto_id" value="{{ producto.id }}">

								<div class="tab-content" id="myTabContent">
									<div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
									<div class="row">
									<div class="col-md-6 mb-3">
												<label class="checkbox-label">
													<input class="form-check-input" type="checkbox" name="destacado" value="{{producto.destacado }}" {% if producto.destacado == '1' %} checked {% endif %}>
													Producto destacado
												</label>
											</div>
									</div>
										<div class="row">
											<div class="col-md-6 mb-3">
												<label for="nombre" class="form-label">Nombre del Producto</label>
												<input type="text" class="form-control" id="nombre" name="nombre" value="{{ producto.nombre }}" required>
											</div>
											<div class="col-md-6 mb-3">
												<label for="sku" class="form-label">SKU</label>
												<input type="text" class="form-control" id="sku" name="sku" value="{{ producto.sku }}" required>
											</div>
										</div>

										<div class="row">
											<div class="col-md-6 mb-3">
												<label for="precio" class="form-label">Precio</label>
												<input type="number" step="0.01" class="form-control" id="precio" name="precio" value="{{ producto.precio }}" required>
											</div>
											<div class="col-md-6 mb-3">
												<label for="precio_anterior" class="form-label">Precio Oferta</label>
												<input type="text"  class="form-control" id="precio_anterior" name="precio_anterior" value="{{ producto.precio_anterior }}" required>
											</div>
											<div class="col-md-6 mb-3">
												<label for="stock" class="form-label">Stock</label>
												<input type="number" class="form-control" id="stock" name="stock" value="{{ producto.stock }}" required>
											</div>
										</div>

										<div class="row">
											<div class="col-md-6 mb-3">
												<label for="categoria_id" class="form-label">Categoría</label>
												<select class="select" id="categoria_id" name="categoria_id">
													<option value="">Seleccionar categoría</option>
													{% for cat in categorias %}
														<option value="{{ cat.id }}" {% if producto.categoria_id == cat.id %} selected {% endif %}>{{ cat.nombre }}</option>
													{% endfor %}
												</select>
											</div>
											<div class="col-md-6 mb-3">
												<label for="subcategoria_id" class="form-label">Subcategoría</label>
												<select class="select" id="subcategoria_id" name="subcategoria_id">
													<option value="">Seleccionar subcategoría</option>
													{% for subcat in subcategorias %}
														<option value="{{ subcat.Subcategoria_ID }}" {% if producto.subcategoria_id == subcat.Subcategoria_ID %} selected {% endif %}>{{ subcat.Subcategoria }}</option>
													{% endfor %}
												</select>
											</div>
											<div class="col-md-6 mb-3">
												<label for="estado" class="form-label">Estado</label>
												<select class="select" id="estado" name="estado">
													<option value="1" {% if producto.estado == '1' %} selected {% endif %}>Activo</option>
													<option value="0" {% if producto.estado == '0' %} selected {% endif %}>Inactivo</option>
												</select>
											</div>
										</div>
										<div class="row">
											<div class="col-12 mb-3">
												<label for="descripcion" class="form-label">Descripción</label>
												<textarea class="form-control" id="descripcion" name="descripcion" rows="4">{{ producto.descripcion }}</textarea>
											</div>
										</div>
										<div class="row">
											<div class="col-12 mb-3">
												<label for="imagen" class="form-label">Imagen Principal
													<code>(Formato PNG o JPEG Tamaño: 300x350px, no exceder 1GB)</code>
												</label>
												<input type="file" class="form-control" id="imagen" name="imagen">
											</div>
										</div>
										<div class="row">
											<div class="col-12 mb-3">
												<label for="informacion_adicional" class="form-label">Información Adicional
													<code>(Formato PNG o JPEG, no exceder 1GB)</code>
												</label>
												<input type="file" class="form-control" id="informacion_adicional" name="informacion_adicional">
											</div>
										</div>
									</div>
								</div>
							</form>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-primary" id="btnGuardarEdicion">Guardar Cambios</button>
					</div>
				</div>
			</div>
		</div>


	{% endblock %}

	{% block extraScripts %} <script src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js"></script>
		 <script src="{{ adminAssetsUrl }}/js/frontend/perfilproducto.js?{{ random() }}"></script>
	{% endblock %}
