{% extends "admin/base.twig" %}

{% block extraStyles %}{% endblock %}

{% block body %}


	<div class="form-head d-flex mb-3 mb-md-5 align-items-start flex-wrap justify-content-between">
		<div class="me-auto d-lg-block">
			<h3 class="text-primary font-w600">Logos Clientes</h3>
		</div>
		<button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modLogos">
			<i class="fas fa-plus"></i>
			Nuevo Logo
		</button>
	</div>

	<div class="row">
		<div class="col-12">
			<div class="card">
				<div class="card-body px-3 pt-2 pb-0">
					<div class="row p-3">

						<div class="col-12">
							<div class="table-responsive">
								<table class="table table-hover" id="tabLogos">
									<thead>
										<tr>
											<th>ID</th>
											<th>Imagen</th>
											<th>Nombre</th>
											
											<th>Acciones</th>
										</tr>
									</thead>
									<tbody></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="modLogos" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-xl">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="exampleModalLabel">Logo</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<form id="frmLogos" enctype="multipart/form-data" autocomplete="off" data-endpoint="{{ adminUrl }}/logosclientes" data-image-base="{{ baseUrl }}uploads/logos/">
						<input type="hidden" name="id" id="id">

						<div class="row">
							<div class="col-md-12">
								<div class="form-group">
									<label for="nombre">Nombre cliente o empresa</label>
									<input type="text" class="form-control" id="nombre" name="nombre" maxlength="255" required/>
								</div>
							</div>



							<div class="col-md-12">
								<div class="form-group">
									<label for="imagen">Imagen <code>(* la imagen debe ser de 258x54px)</code></label>
									<input type="file" name="imagen" id="imagen" class="form-control" accept="image/jpeg,image/png,image/webp,image/gif">
								</div>
							</div>
						</div>
					</form>

				</div>
				<div class="modal-footer">
					<button class="btn btn-primary" type="button" id="btGuardar">Guardar
					</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
{% block extraScripts %}
	 <script src="{{ adminAssetsUrl }}/js/frontend/logos.js?x={{ " now"|date("dmYHis") }}"></script>
{% endblock %}
