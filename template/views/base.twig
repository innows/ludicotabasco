<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow">
<meta name="author" content="Lúdico de México">
<title>Ludico | Suministro e instalación de mobiliario y equipamiento recreativo deportivo y urbano</title>
<meta name="description" content="Conoce nuestras soluciones en acción y descubre cómo el equipamiento recreativo, deportivo y urbano contribuye a crear espacios funcionales, atractivos en el Sureste. Cotiza en línea.">
<meta name="keywords" content="equipamiento para parques, juegos infantiles para parques, mobiliario urbano villahermosa, ejercitadores al aire libre, juegos modulares infantiles, piso de caucho amortiguante, pasto sintetico, bancas para parques">
<link rel="canonical" href="https://www.ludicodemexico.com.mx/">
<link rel="icon" type="image/png" href="assets/images/favicon/favicon-96x96.png" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="assets/images/favicon/favicon.svg">
<link rel="shortcut icon" href="assets/images/favicon/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="assets/images/favicon/apple-touch-icon.png">
<link rel="manifest" href="assets/images/favicon/site.webmanifest">
<meta property="og:type" content="website">
<meta property="og:locale" content="es_MX">
<meta property="og:url" content="https://www.ludicodemexico.com.mx/">
<meta property="og:title" content="Lúdico | Suministro e instalación de mobiliario y equipamiento recreativo deportivo y urbano">
<meta property="og:description" content="Suministro e instalación de juegos infantiles, ejercitadores al aire libre y mobiliario urbano con cobertura en el Sureste.">
<meta property="og:image" content="{% block og_image %}https://www.ludicodemexico.com.mx/assets/images/og-image.jpg{% endblock %}">
<base href="{{ baseUrl }}">
{% include "modules/globalStyles.twig" %}
	</head>
	<body class="color-ludico">
		<div class="loader-wrapper">
			<div class="loader"></div>
			<div class="loader-section section-left"></div>
			<div class="loader-section section-right"></div>
		</div>
		<header class="header-one style-four top-transparent-header header--sticky">
			<div class="header-top-area-wrapper">
				<div class="container">
					<div class="row">
						<div class="col-lg-12">
							<div class="header-top-one-wrapper ">
								<div class="right">
									<p>Encuentra tu equipamiento
										<a href="#" class="search" id="search" aria-label="Search">
											<i class="far fa-search ms-3"></i>
										</a>
									</p>
								</div>
								<div class="left">
									<div class="mail">
										<a href="mailto:{{ config.email|default('') }}">
											<i class="fal fa-envelope"></i>
											{{ config.email|default('') }}</a>
									</div>

								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="header-main">
				<div class="container">
					<div class="row">
						<div class="col-lg-12">
							<div class="header-main-one-wrapper header-seven">
								<div class="thumbnail">
									<a href="index">
										<img src="assets/images/logo.png" alt="ludico-logo">
									</a>
								</div>
								<div class="main-header">
									{% include "modules/menu.twig" %}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>

		{% block body %}{% endblock %}
		{% if logos %}
<div class="rts-trusted-client rts-section-gapBottom">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="title-area-client-client text-center">
                    <p class="client-title">Clientes que nos respaldan</p>
                </div>
            </div>
        </div>
        <div class="row mt--65">
            <div class="col-lg-12">
                <div class="client-three-wrapper">
                    {% for item in logos %}
                        <div class="single">
                            {# Ajusta 'item.imagen' por el nombre real de tu columna en la base de datos #}
                            <img src="uploads/logos/{{ item.Logo_url }}" alt="{{ item.Nombre ?? 'Business_client' }}">
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

		<div class="rts-footer-area in-green-demo with-hr-demo footer-three rts-section-gapTop footer-bg-2">
			<div class="container pb--100 pb_sm--40">
				<div class="row g-5">
					<div class="col-xl-3 col-lg-3">
						<div class="footer-three-single-wized">
							<a href="index" class="logo_footer text-center">
								<img src="assets/images/icon-logo.png" alt="Logo-image" width="150px">
							</a>
							<p class="disc text-justify">Suministro e instalación de mobiliario y equipamiento recreativo deportivo y urbano
							</p>
							<ul class="social-three-wrapper">
								{% if config.facebook %}
									<li>
										<a href="{{ config.facebook|default('#') }}" target="_blank" rel="noopener noreferrer">
											<i class="fab fa-facebook-f"></i>
										</a>
									</li>
								{% endif %}
								{% if config.twitter %}
									<li>
										<a href="{{ config.twitter|default('#') }}" target="_blank" rel="noopener noreferrer">
											<i class="fab fa-twitter"></i>
										</a>
									</li>
								{% endif %}
								{% if config.instagram %}
									<li>
										<a href="{{ config.instagram|default('#') }}" target="_blank" rel="noopener noreferrer">
											<i class="fab fa-instagram"></i>
										</a>
									</li>
								{% endif %}
								{% if config.tiktok %}
									<li>
										<a href="{{ config.tiktok|default('#') }}" target="_blank" rel="noopener noreferrer">
											<i class="fab fa-tiktok"></i>
										</a>
									</li>
								{% endif %}

							</ul>
						</div>
					</div>
					<div class="col-xl-9 col-lg-9">
						<div class="row">
							<div class="col-lg-5">
								<div class="footer-three-single-wized footer-two-single-wized mid-left">
									<div class="wized-title-area mb--15">
										<h5 class="wized-title">Contáctanos</h5>

									</div>
									<div class="body">
										<div class="info-wrapper">
											<div class="single">
												<ul class="icon">
													<li>
														<i class="fas fa-phone-alt"></i>
													</li>
												</ul>
												<div class="info">
													<span>Teléfono</span>
													<a href="tel:{{ config.telefono|default('') }}">{{ config.telefono|default('') }}</a>
												</div>
											</div>
											{% if config.email %}
												<div class="single">
													<ul class="icon">
														<li>
															<i class="far fa-envelope"></i>
														</li>
													</ul>
													<div class="info">
														<span>Correo Electrónico</span>
														<a href="mailto:{{ config.email|default('') }}">{{ config.email|default('') }}</a>
													</div>
												</div>
											{% endif %}
											{% if config.direccion %}
												<div class="single">
													<ul class="icon">
														<li>
															<i class="fas fa-map-marker-alt"></i>
														</li>
													</ul>
													<div class="info">
														<span>Dirección</span>
														<a href="#">{{ config.direccion|default('') }}</a>
													</div>
												</div>
											{% endif %}

										</div>
									</div>
								</div>
							</div>
							<div class="col-lg-4 d-none d-xl-block">
								<div class="footer-two-single-wized two">
									<div class="wized-title-area">
										<h5 class="wized-title">Atencion WhatsApp</h5>
									</div>
									<div class="wized-2-body text-center">
										<img src="assets/images/qr-code.png" width="150" alt="qr">
									</div>
								</div>
							</div>
							<div class="col-lg-3">
								<div class="footer-two-single-wized two mt-xl-5">
									<div class="wized-title-area">
										<h5 class="wized-title">¡Conócenos!</h5>
									</div>
									<div class="wized-2-body">
										<ul>
											<li><a href="conoce-ludico"><i class="fal fa-chevron-double-right"></i>Quienes somos</a></li>
											<li><a href="portafolio"><i class="fal fa-chevron-double-right"></i>Portafolio</a></li>
											<li><a href="contacto"><i class="fal fa-chevron-double-right"></i>Contacto</a></li>
											<li><a href="aviso-de-privacidad"><i class="fal fa-chevron-double-right"></i>Aviso de Privacidad</a></li>
										</ul>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="copyright-area ptb--20">
				<div class="container">
					<div class="row">
						<div class="col-12">
							<p class="disc text-center">
								LUDICO - Copyright
								{{ "now"|date("Y") }}
								. All rights reserved.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div id="side-bar" class="side-bar header-two">
			<button class="close-icon-menu" title="Close menu">
				<i class="far fa-times"></i>
			</button>
			<div class="rts-sidebar-menu-desktop">
				<a class="logo-1" href="index"><img class="logo" src="assets/images/logo.png" alt="ludico"></a>

			</div>
			<div class="mobile-menu d-block d-xl-none">
				<nav class="nav-main mainmenu-nav mt--30">
					<ul class="mainmenu metismenu" id="mobile-menu-active">
						<li class="main">
							<a href="{{ baseUrl }}index" class="main" aria-expanded="false">Inicio</a>

						</li>

						{% for cat in menu_categorias %}
							{% if not cat.has_sub %}
								<li class="main" class="main" aria-expanded="false">
									<a href="{{ baseUrl }}{{ cat.slug }}">{{ cat.nombre }}</a>
								</li>
							{% else %}
								<li class="has-droupdown">
									<a href="#" class="main" aria-expanded="false">{{ cat.nombre }}</a>
									<ul class="submenu mm-collapse">
										{% for sub in cat.subcategorias %}
											<li>
												<a href="{{ baseUrl }}{{ cat.slug }}/{{ sub.slugSubcategoria }}">{{ sub.nombre }}</a>
											</li>
										{% endfor %}
									</ul>
								</li>
							{% endif %}
						{% endfor %}
					</ul>
				</nav>

			</div>

		</div>
		<div class="search-input-area">
			<div class="container">
				<div class="search-input-inner">
					<div class="input-div">
						<input class="search-input autocomplete" type="text" placeholder="Ingresa tu búsqueda...">
						<button>
							<i class="far fa-search"></i>
						</button>
					</div>
				</div>
			</div>
			<div id="close" class="search-close-icon">
				<i class="far fa-times"></i>
			</div>
		</div>
		<div id="anywhere-home" class=""></div>

		<div class="progress-wrap">
			<svg class="progress-circle svg-content" width="100%" height="100%" viewbox="-1 -1 102 102">
				<path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98" style="transition: stroke-dashoffset 10ms linear; stroke-dasharray: 307.919, 307.919; stroke-dashoffset: 307.919;"></path>
			</svg>
		</div>
		<div class="offcanvas-overlay"></div>
		<div class="fix">
			<div class="sidebar-action sidebar-cart">
				<button class="close-sidebar">
					<i class="fa-solid fa-xmark"></i>
				</button>
				<h4 class="sidebar-action-title">Detalles de Cotización</h4>
				<div class="sidebar-action-list" aria-live="polite">

				</div>

				<div class="sidebar-action-btn" id="cartActionBtn" style="display: none;">
					<a href="{{ baseUrl }}cart" class="border-btn text-center" id="goToCart">Enviar cotización</a>
				</div>
				<p class="text-center" id="cartEmptyMsg">Tu cotización está vacía</p>

			</div>
		</div>
		{% include "modules/globalScripts.twig" %}

		{% block extraScripts %}{% endblock %}
	</body>
</html>
